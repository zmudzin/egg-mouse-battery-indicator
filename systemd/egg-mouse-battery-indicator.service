[Unit]
Description=Endgame Gear Mouse Battery Indicator & Configuration Daemon
Documentation=https://github.com/zmudzin/egg-mouse-battery-indicator
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/egg-mouse-battery-indicator
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
